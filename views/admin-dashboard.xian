<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[radial-gradient(circle_at_top,_#f0f9ff_0%,_#f8fbff_48%,_#ffffff_100%)] text-slate-800">
  <header class="sticky top-0 z-30 border-b border-sky-100 bg-white/95 p-4 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <div>
        <h1 class="text-xl font-extrabold text-slate-900">Admin Dashboard</h1>
        <p class="text-xs text-slate-500">Hospital Administration and System Control Center</p>
      </div>
      <a href="/logout" class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100">Logout</a>
    </div>
  </header>

  <main class="mx-auto max-w-7xl space-y-6 p-6">
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <article class="rounded-2xl border border-sky-100 bg-white p-5 shadow-sm shadow-sky-100/70">
        <p class="text-xs font-semibold uppercase tracking-wide text-sky-700">Registered Patients</p>
        <p class="mt-2 text-3xl font-extrabold text-slate-900">{{stats.totalPatients}}</p>
      </article>
      <article class="rounded-2xl border border-sky-100 bg-white p-5 shadow-sm shadow-sky-100/70">
        <p class="text-xs font-semibold uppercase tracking-wide text-sky-700">Registered Doctors</p>
        <p class="mt-2 text-3xl font-extrabold text-slate-900">{{stats.totalDoctors}}</p>
      </article>
      <article class="rounded-2xl border border-sky-100 bg-white p-5 shadow-sm shadow-sky-100/70">
        <p class="text-xs font-semibold uppercase tracking-wide text-sky-700">Registered Nurses</p>
        <p class="mt-2 text-3xl font-extrabold text-slate-900">{{stats.totalNurses}}</p>
      </article>
      <article class="rounded-2xl border border-sky-100 bg-white p-5 shadow-sm shadow-sky-100/70">
        <p class="text-xs font-semibold uppercase tracking-wide text-sky-700">Total Appointments</p>
        <p class="mt-2 text-3xl font-extrabold text-slate-900">{{stats.totalAppointments}}</p>
      </article>
    </section>

    <section class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <p class="text-xs uppercase tracking-wide text-slate-500">Total Users</p>
        <p class="mt-2 text-2xl font-bold text-slate-900">{{stats.totalUsers}}</p>
      </article>
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <p class="text-xs uppercase tracking-wide text-slate-500">Active Accounts</p>
        <p class="mt-2 text-2xl font-bold text-emerald-600">{{stats.activeAccounts}}</p>
      </article>
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <p class="text-xs uppercase tracking-wide text-slate-500">Blocked Accounts</p>
        <p class="mt-2 text-2xl font-bold text-rose-600">{{stats.blockedAccounts}}</p>
      </article>
    </section>

    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">1. User Management</h2>
        <p class="mt-1 text-sm text-slate-600">Add, edit, delete users, assign roles, and activate or deactivate accounts.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Admins</p><p class="font-bold text-sky-700">{{stats.totalAdmins}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Super Admins</p><p class="font-bold text-sky-700">{{stats.totalSuperAdmins}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Medical Staff</p><p class="font-bold text-sky-700">{{stats.medicalStaffCount}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Inactive</p><p class="font-bold text-amber-700">{{stats.inactiveAccounts}}</p></div>
        </div>
        <div class="mt-4 space-y-2">
          <p class="text-sm font-semibold text-slate-700">Recent User Registrations</p>
          {{#if recentUsers.length}}
            {{#each recentUsers}}
              <div class="rounded-lg border border-slate-100 p-3 text-sm">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold text-slate-800">{{name}} <span class="font-normal text-slate-500">({{role}})</span></p>
                    <p class="text-slate-500">{{email}} • {{status}} • {{createdAtText}}</p>
                  </div>
                  <button
                    class="user-status-btn rounded-lg px-3 py-1 text-xs font-semibold text-white {{userActionClass}}"
                    data-user-id="{{id}}"
                    data-user-name="{{name}}"
                    data-user-status="{{status}}"
                  >
                    {{userActionText}}
                  </button>
                </div>
              </div>
            {{/each}}
          {{else}}
            <p class="text-sm text-slate-500">No users found.</p>
          {{/if}}
        </div>
      </article>

      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">2. Appointment Management</h2>
        <p class="mt-1 text-sm text-slate-600">Track pending, approved, completed, cancelled appointments and monitor schedule volume.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Total</p><p class="font-bold text-slate-900">{{stats.totalAppointments}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Today</p><p class="font-bold text-slate-900">{{stats.todayAppointments}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">This Month</p><p class="font-bold text-slate-900">{{stats.monthAppointments}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">With Doctor Schedule</p><p class="font-bold text-slate-900">{{stats.doctorsWithSchedule}}</p></div>
        </div>
        <div class="mt-4 space-y-3">
          {{#each appointmentStatusItems}}
            <div>
              <div class="mb-1 flex items-center justify-between text-xs text-slate-600">
                <span>{{label}}</span>
                <span>{{count}}</span>
              </div>
              <div class="h-2 rounded-full bg-slate-100">
                <div class="{{color}} {{widthClass}} h-2 rounded-full"></div>
              </div>
            </div>
          {{/each}}
        </div>
      </article>
    </section>

    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">3. Medical Records Management</h2>
        <p class="mt-1 text-sm text-slate-600">Manage patient records, updates, history, and privacy controls.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Total Records</p><p class="font-bold text-slate-900">{{stats.totalMedicalRecords}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Updated This Month</p><p class="font-bold text-slate-900">{{stats.updatedMedicalRecordsMonthly}}</p></div>
        </div>
        <p class="mt-3 text-xs text-slate-500">Audit logs below track medical and user-level activity updates.</p>
      </article>

      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">4. Dashboard Analytics</h2>
        <p class="mt-1 text-sm text-slate-600">Consultation trends and system usage snapshots.</p>
        <div class="mt-4 space-y-3">
          {{#each consultationTrendBars}}
            <div>
              <div class="mb-1 flex items-center justify-between text-xs text-slate-600">
                <span>{{label}} Consultations</span>
                <span>{{count}}</span>
              </div>
              <div class="h-2 rounded-full bg-sky-100">
                <div class="{{widthClass}} h-2 rounded-full bg-sky-500"></div>
              </div>
            </div>
          {{/each}}
        </div>
        <div class="mt-4 grid grid-cols-3 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Total</p><p class="font-bold text-slate-900">{{stats.consultationsTotal}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Daily</p><p class="font-bold text-slate-900">{{stats.consultationsDaily}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Monthly</p><p class="font-bold text-slate-900">{{stats.consultationsMonthly}}</p></div>
        </div>
      </article>
    </section>

    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">5. Messaging and Notifications</h2>
        <p class="mt-1 text-sm text-slate-600">Manage announcement flow and reminder notifications.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Total Notifications</p><p class="font-bold text-slate-900">{{stats.totalNotifications}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Unread</p><p class="font-bold text-amber-700">{{stats.unreadNotifications}}</p></div>
        </div>
      </article>

      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">6. System Settings</h2>
        <p class="mt-1 text-sm text-slate-600">System identity, consultation fee controls, and schedule configuration summary.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Average Consultation Fee</p><p class="font-bold text-slate-900">{{stats.avgConsultationFee}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Active Doctors</p><p class="font-bold text-slate-900">{{stats.doctorsWithSchedule}}</p></div>
        </div>
      </article>
    </section>

    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">7. Security and Access Control</h2>
        <p class="mt-1 text-sm text-slate-600">RBAC visibility, login monitoring, and activity audits for compliance.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Logins Today</p><p class="font-bold text-slate-900">{{stats.loginEventsToday}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Audit Logs This Month</p><p class="font-bold text-slate-900">{{stats.auditTrailCountMonthly}}</p></div>
        </div>
        <div class="mt-4 space-y-2">
          {{#if recentActivity.length}}
            {{#each recentActivity}}
              <div class="rounded-lg border border-slate-100 p-3 text-sm">
                <p class="font-semibold text-slate-800">{{action}}</p>
                <p class="text-slate-500">{{description}}</p>
                <p class="text-xs text-slate-400">{{createdAtText}}</p>
              </div>
            {{/each}}
          {{else}}
            <p class="text-sm text-slate-500">No recent activity yet.</p>
          {{/if}}
        </div>
      </article>

      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">8. Feedback and Support Management</h2>
        <p class="mt-1 text-sm text-slate-600">Track complaints, feedback, and support ticket resolution flow.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Open Issues</p><p class="font-bold text-rose-600">{{stats.feedbackOpen}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Resolved Issues</p><p class="font-bold text-emerald-600">{{stats.feedbackResolved}}</p></div>
        </div>
      </article>
    </section>

    <section class="grid grid-cols-1 gap-6">
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">Usage Trend Snapshot</h2>
        <p class="mt-1 text-sm text-slate-600">Monthly appointment trend for quick operational planning.</p>
        <div class="mt-4 space-y-3">
          {{#each monthlyAppointmentBars}}
            <div>
              <div class="mb-1 flex items-center justify-between text-xs text-slate-600">
                <span>{{label}}</span>
                <span>{{count}}</span>
              </div>
              <div class="h-2 rounded-full bg-sky-100">
                <div class="{{widthClass}} h-2 rounded-full bg-sky-500"></div>
              </div>
            </div>
          {{/each}}
        </div>
      </article>
    </section>

    <section class="rounded-2xl border border-sky-100 bg-white p-5">
      <h2 class="text-lg font-bold text-slate-900">Recent Appointment Activity</h2>
      {{#if recentAppointments.length}}
        <div class="mt-3 space-y-2">
          {{#each recentAppointments}}
            <div class="rounded-lg border border-slate-100 p-3 text-sm">
              <p class="font-semibold text-slate-800">Appointment #{{id}} • {{status}}</p>
              <p class="text-slate-500">{{appointmentDateText}} • {{consultationType}}</p>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="mt-3 text-sm text-slate-500">No recent appointments.</p>
      {{/if}}
    </section>

    <section class="rounded-2xl border border-sky-100 bg-white p-5">
      <h2 class="text-lg font-bold text-slate-900">Role Distribution</h2>
      <div class="mt-4 space-y-3">
        {{#each userRoleItems}}
          <div>
            <div class="mb-1 flex items-center justify-between text-xs text-slate-600">
              <span>{{label}}</span>
              <span>{{count}}</span>
            </div>
            <div class="h-2 rounded-full bg-slate-100">
              <div class="{{widthClass}} h-2 rounded-full bg-sky-600"></div>
            </div>
          </div>
        {{/each}}
      </div>
    </section>

    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">9. Reports Generation</h2>
        <p class="mt-1 text-sm text-slate-600">Open live reports for users, appointments, consultations, and activity logs.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <button id="load-reports-btn" class="rounded-lg bg-sky-50 p-3 text-center font-semibold text-sky-700 hover:bg-sky-100">View System Reports</button>
          <button id="load-activity-btn" class="rounded-lg bg-sky-50 p-3 text-center font-semibold text-sky-700 hover:bg-sky-100">View Activity Logs</button>
        </div>
        <div id="admin-report-output" class="mt-4 hidden rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-700"></div>
      </article>

      <article class="rounded-2xl border border-sky-100 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">10. Security and Data Backup</h2>
        <p class="mt-1 text-sm text-slate-600">Monitor access control, login events, and audit trails for suspicious activity.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Logins Today</p><p class="font-bold text-slate-900">{{stats.loginEventsToday}}</p></div>
          <div class="rounded-lg bg-sky-50 p-3"><p class="text-slate-500">Audit Logs</p><p class="font-bold text-slate-900">{{stats.auditTrailCountMonthly}}</p></div>
        </div>
        <div class="mt-4">
          <a href="/admin/activity-logs" class="inline-flex rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Review Security Logs</a>
        </div>
      </article>
    </section>
  </main>

  <script>
    const reportOutput = document.getElementById('admin-report-output');

    const renderOutput = (title, payload) => {
      if (!reportOutput) return;
      reportOutput.classList.remove('hidden');
      reportOutput.innerHTML = `
        <p class="mb-2 text-sm font-semibold text-slate-800">${title}</p>
        <pre class="max-h-80 overflow-auto whitespace-pre-wrap break-words">${JSON.stringify(payload, null, 2)}</pre>
      `;
    };

    const setButtonState = (button, busyText, doneText) => {
      if (!button) return;
      button.disabled = true;
      button.textContent = busyText;
      setTimeout(() => {
        button.disabled = false;
        button.textContent = doneText;
      }, 700);
    };

    const handleUserStatusAction = async (button) => {
      const userId = button.getAttribute('data-user-id');
      const userName = button.getAttribute('data-user-name') || 'this user';
      const currentStatus = button.getAttribute('data-user-status');
      const shouldUnblock = currentStatus === 'blocked';
      const endpoint = shouldUnblock ? `/admin/user/${userId}/unblock` : `/admin/user/${userId}/block`;

      if (!confirm(`${shouldUnblock ? 'Unblock' : 'Block'} ${userName}?`)) return;

      const oldText = button.textContent;
      button.disabled = true;
      button.textContent = 'Processing...';

      try {
        const response = await fetch(endpoint, { method: 'PUT' });
        const payload = await response.json();

        if (!response.ok) {
          throw new Error(payload.error || 'Request failed');
        }

        button.setAttribute('data-user-status', shouldUnblock ? 'active' : 'blocked');
        button.classList.remove('bg-rose-600', 'hover:bg-rose-700', 'bg-emerald-600', 'hover:bg-emerald-700');
        if (shouldUnblock) {
          button.classList.add('bg-rose-600', 'hover:bg-rose-700');
          button.textContent = 'Block';
        } else {
          button.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
          button.textContent = 'Unblock';
        }
      } catch (error) {
        alert('❌ Error: ' + error.message);
        button.textContent = oldText;
      } finally {
        button.disabled = false;
      }
    };

    const loadJsonPanel = async (button, endpoint, title) => {
      const originalText = button.textContent;
      setButtonState(button, 'Loading...', originalText);

      try {
        const response = await fetch(endpoint);
        const payload = await response.json();
        if (!response.ok) {
          throw new Error(payload.error || 'Request failed');
        }
        renderOutput(title, payload);
      } catch (error) {
        renderOutput(`${title} (Error)`, { error: error.message });
      }
    };

    document.querySelectorAll('.user-status-btn').forEach((button) => {
      button.addEventListener('click', () => handleUserStatusAction(button));
    });

    const loadReportsBtn = document.getElementById('load-reports-btn');
    if (loadReportsBtn) {
      loadReportsBtn.addEventListener('click', () => loadJsonPanel(loadReportsBtn, '/admin/reports', 'System Reports'));
    }

    const loadActivityBtn = document.getElementById('load-activity-btn');
    if (loadActivityBtn) {
      loadActivityBtn.addEventListener('click', () => loadJsonPanel(loadActivityBtn, '/admin/activity-logs?limit=25', 'Recent Activity Logs'));
    }
  </script>
</body>
</html>
