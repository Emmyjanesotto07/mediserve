<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Verified | MEDISERVE</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-green-50 to-emerald-100 min-h-screen flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full">
    <!-- Success Icon -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 rounded-full mb-4 animate-pulse">
        <span class="text-5xl">✓</span>
      </div>
      <h1 class="text-3xl font-bold text-slate-900">Email Verified!</h1>
      <p class="text-slate-600 mt-2">Your account is ready to use</p>
    </div>

    <!-- Success Message -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
      <p class="text-green-900 text-sm leading-relaxed">
        {{message}}
      </p>
    </div>

    <!-- Email Display -->
    <div class="bg-slate-50 rounded-lg p-4 mb-6 text-center">
      <p class="text-xs text-slate-600 font-semibold uppercase mb-1">Verified Email</p>
      <p class="text-lg font-semibold text-slate-900 break-all">{{email}}</p>
    </div>

    <!-- Celebrate -->
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg p-6 mb-6 text-center">
      <p class="text-4xl mb-3">🎉</p>
      <h3 class="font-bold text-slate-900 mb-2">Welcome to MEDISERVE!</h3>
      <p class="text-sm text-slate-700">
        Your account is now fully activated. You can access all features including online consultations, medical records, and prescription management.
      </p>
    </div>

    <!-- CTA Button -->
    <a href="/login" class="block w-full bg-green-600 text-white py-3 rounded-lg font-bold hover:bg-green-700 transition duration-200 text-center mb-3">
      🚀 Login to Your Account
    </a>

    <!-- Secondary Button -->
    <a href="/" class="block w-full bg-slate-100 text-slate-900 py-3 rounded-lg font-semibold hover:bg-slate-200 transition duration-200 text-center">
      ← Back to Home
    </a>

    <!-- Features List -->
    <div class="mt-8 grid grid-cols-2 gap-3">
      <div class="bg-slate-50 rounded-lg p-3 text-center">
        <p class="text-2xl mb-1">💻</p>
        <p class="text-xs font-semibold text-slate-800">Consultations</p>
      </div>
      <div class="bg-slate-50 rounded-lg p-3 text-center">
        <p class="text-2xl mb-1">📂</p>
        <p class="text-xs font-semibold text-slate-800">Medical Records</p>
      </div>
      <div class="bg-slate-50 rounded-lg p-3 text-center">
        <p class="text-2xl mb-1">💊</p>
        <p class="text-xs font-semibold text-slate-800">Prescriptions</p>
      </div>
      <div class="bg-slate-50 rounded-lg p-3 text-center">
        <p class="text-2xl mb-1">🔔</p>
        <p class="text-xs font-semibold text-slate-800">Notifications</p>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-8 pt-6 border-t border-slate-200">
      <p class="text-center text-xs text-slate-500">
        Need help? 
        <a href="/" class="text-green-600 hover:underline font-semibold">Contact Support</a>
      </p>
    </div>
  </div>

  <!-- Background decoration -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-20 left-10 w-40 h-40 bg-green-200 rounded-full opacity-20 blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-40 h-40 bg-emerald-200 rounded-full opacity-20 blur-3xl"></div>
  </div>
</body>
</html>
