<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Error</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-6">
  <div class="bg-white rounded-xl shadow p-6 max-w-lg w-full text-center">
    <h1 class="text-2xl font-bold text-red-600 mb-2">Something went wrong</h1>
    <p class="text-slate-600 mb-4">{{message}}</p>
    <a href="/" class="inline-block px-4 py-2 bg-slate-900 text-white rounded-lg">Go Home</a>
  </div>
</body>
</html>
