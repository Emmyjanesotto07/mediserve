{{> head}}
<body class="bg-gray-50 text-gray-800">
  <!-- Header -->
  <header class="bg-white border-b border-gray-200 px-6 py-4 sticky top-0 z-50 shadow-sm">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center text-white font-bold">M</div>
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Mediserve</h1>
          <p class="text-xs text-gray-500">{{patient.name}}</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <button class="text-gray-600 hover:text-gray-900"><i class="fas fa-bell"></i></button>
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white text-sm font-semibold">
          {{#if patient.profilePicture}}
            <img src="{{patient.profilePicture}}" alt="{{patient.name}}" class="w-10 h-10 rounded-full object-cover">
          {{else}}
            {{patient.name.[0]}}
          {{/if}}
        </div>
      </div>
    </div>
  </header>

  <div class="flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 p-6 h-[calc(100vh-80px)] overflow-y-auto">
      <nav class="space-y-1">
        <a href="/patient-dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-100 transition text-gray-700">
          <i class="fas fa-home w-5"></i>
          <span>Home</span>
        </a>
        <a href="/messages" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-100 transition text-gray-700">
          <i class="fas fa-comments w-5"></i>
          <span>Messages</span>
          <span class="ml-auto bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">5</span>
        </a>
        <a href="/appointments" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-100 transition text-gray-700">
          <i class="fas fa-calendar w-5"></i>
          <span>Appointments</span>
        </a>
        <a href="/medical-records" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-100 transition text-gray-700 font-medium bg-blue-50 text-blue-600 border-l-4 border-blue-600">
          <i class="fas fa-file-medical w-5"></i>
          <span>Medical Records</span>
        </a>
        <hr class="my-4 border-gray-200">
        <a href="/profile" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-100 transition text-gray-700">
          <i class="fas fa-cog w-5"></i>
          <span>Settings</span>
        </a>
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-red-50 hover:text-red-600 transition text-gray-700">
          <i class="fas fa-sign-out-alt w-5"></i>
          <span>Logout</span>
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto p-6">
      <div class="max-w-4xl">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Medical Records</h1>
        <p class="text-gray-600 mb-6">View your complete medical history including diagnoses, treatments, and test results.</p>

        {{#if records.length}}
          <div class="space-y-4">
            {{#each records}}
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                      <i class="fas fa-diagnosis text-blue-600"></i>
                      {{diagnosis}}
                    </h3>
                    <p class="text-sm text-gray-500 mt-1">
                      <i class="fas fa-user-md text-gray-400 mr-1"></i>
                      Dr. {{doctor.name}} - {{doctor.specialization}}
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-medium text-gray-700">
                      <i class="fas fa-calendar text-gray-400 mr-1"></i>
                      {{#if recordDateText}}{{recordDateText}}{{else}}{{recordDate}}{{/if}}
                    </p>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 pb-4 border-b border-gray-100">
                  <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase mb-2">Treatment</p>
                    <p class="text-sm text-gray-900 bg-gray-50 p-3 rounded border border-gray-100">
                      <i class="fas fa-prescription-bottle-alt text-gray-400 mr-2"></i>
                      {{treatment}}
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase mb-2">Status</p>
                    <div class="flex items-center gap-2">
                      {{#if (eq status 'active')}}
                        <span class="inline-flex items-center gap-1 px-3 py-2 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                          <i class="fas fa-circle text-green-500"></i>
                          Active
                        </span>
                      {{else if (eq status 'completed')}}
                        <span class="inline-flex items-center gap-1 px-3 py-2 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">
                          <i class="fas fa-check-circle"></i>
                          Completed
                        </span>
                      {{else}}
                        <span class="inline-flex items-center gap-1 px-3 py-2 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">
                          <i class="fas fa-clock"></i>
                          Pending
                        </span>
                      {{/if}}
                    </div>
                  </div>
                </div>

                {{#if notes}}
                  <div class="p-4 bg-amber-50 rounded-lg border border-amber-100 mb-4">
                    <p class="text-xs text-amber-600 font-semibold uppercase mb-2">
                      <i class="fas fa-note-sticky mr-1"></i>
                      Clinical Notes
                    </p>
                    <p class="text-sm text-gray-700">{{notes}}</p>
                  </div>
                {{/if}}

                <div class="flex gap-3">
                  <a href="{{downloadUrl}}" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition font-medium text-sm text-center {{#unless downloadUrl}}pointer-events-none opacity-50{{/unless}}">
                    <i class="fas fa-download mr-2"></i>
                    Download PDF
                  </a>
                  <a href="{{printUrl}}" target="_blank" class="flex-1 bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm text-center">
                    <i class="fas fa-print mr-2"></i>
                    Print Record
                  </a>
                  <button onclick="navigator.share ? navigator.share({ title: 'Medical Record', text: '{{diagnosis}}' }) : alert('Share is not available in this browser')" class="flex-1 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition font-medium text-sm">
                    <i class="fas fa-share-alt mr-2"></i>
                    Share
                  </button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="space-y-4">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                    <i class="fas fa-diagnosis text-blue-600"></i>
                    Seasonal Flu
                  </h3>
                  <p class="text-sm text-gray-500 mt-1">
                    <i class="fas fa-user-md text-gray-400 mr-1"></i>
                    Dr. Maria Santos - Internal Medicine
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-sm font-medium text-gray-700">
                    <i class="fas fa-calendar text-gray-400 mr-1"></i>
                    {{patient.name}}
                  </p>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 pb-4 border-b border-gray-100">
                <div>
                  <p class="text-xs text-gray-500 font-semibold uppercase mb-2">Treatment</p>
                  <p class="text-sm text-gray-900 bg-gray-50 p-3 rounded border border-gray-100">
                    <i class="fas fa-prescription-bottle-alt text-gray-400 mr-2"></i>
                    Rest, fluids, and paracetamol as needed.
                  </p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 font-semibold uppercase mb-2">Status</p>
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1 px-3 py-2 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">
                      <i class="fas fa-check-circle"></i>
                      Completed
                    </span>
                  </div>
                </div>
              </div>

              <div class="p-4 bg-amber-50 rounded-lg border border-amber-100 mb-4">
                <p class="text-xs text-amber-600 font-semibold uppercase mb-2">
                  <i class="fas fa-note-sticky mr-1"></i>
                  Clinical Notes
                </p>
                <p class="text-sm text-gray-700">Patient advised to monitor temperature and return if symptoms worsen.</p>
              </div>

              <div class="flex gap-3">
                <a href="/patient/print-record/demo-1" target="_blank" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition font-medium text-sm text-center">
                  <i class="fas fa-print mr-2"></i>
                  Print Record
                </a>
                <a href="/patient/print-record/demo-1" target="_blank" class="flex-1 bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm text-center">
                  <i class="fas fa-eye mr-2"></i>
                  View Result
                </a>
              </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                    <i class="fas fa-diagnosis text-blue-600"></i>
                    Mild Hypertension
                  </h3>
                  <p class="text-sm text-gray-500 mt-1">
                    <i class="fas fa-user-md text-gray-400 mr-1"></i>
                    Dr. Jorge Reyes - Cardiology
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-sm font-medium text-gray-700">
                    <i class="fas fa-calendar text-gray-400 mr-1"></i>
                    {{patient.name}}
                  </p>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 pb-4 border-b border-gray-100">
                <div>
                  <p class="text-xs text-gray-500 font-semibold uppercase mb-2">Treatment</p>
                  <p class="text-sm text-gray-900 bg-gray-50 p-3 rounded border border-gray-100">
                    <i class="fas fa-prescription-bottle-alt text-gray-400 mr-2"></i>
                    Low-salt diet, exercise, and daily blood pressure monitoring.
                  </p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 font-semibold uppercase mb-2">Status</p>
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1 px-3 py-2 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                      <i class="fas fa-circle text-green-500"></i>
                      Active
                    </span>
                  </div>
                </div>
              </div>

              <div class="p-4 bg-amber-50 rounded-lg border border-amber-100 mb-4">
                <p class="text-xs text-amber-600 font-semibold uppercase mb-2">
                  <i class="fas fa-note-sticky mr-1"></i>
                  Clinical Notes
                </p>
                <p class="text-sm text-gray-700">Follow-up checkup scheduled after 2 weeks.</p>
              </div>

              <div class="flex gap-3">
                <a href="/patient/print-record/demo-2" target="_blank" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition font-medium text-sm text-center">
                  <i class="fas fa-print mr-2"></i>
                  Print Record
                </a>
                <a href="/patient/print-record/demo-2" target="_blank" class="flex-1 bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm text-center">
                  <i class="fas fa-eye mr-2"></i>
                  View Result
                </a>
              </div>
            </div>
          </div>
        {{/if}}
      </div>
    </main>
  </div>
</body>
</html>
