<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: "Manrope", sans-serif;
    }
  </style>
</head>
<body class="bg-[radial-gradient(circle_at_top,_#f0f9ff_0%,_#eff6ff_45%,_#ffffff_100%)] text-slate-800">
  <header class="sticky top-0 z-40 border-b border-sky-100 bg-white/90 backdrop-blur">
    <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-700">Mediserve Nursing Operations</p>
        <h1 class="text-2xl font-extrabold text-slate-900">Nurse Dashboard</h1>
      </div>
      <div class="flex items-center gap-3">
        <a href="/logout" class="rounded-xl border border-sky-200 bg-white px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-50">Logout</a>
      </div>
    </div>
  </header>

  <main class="mx-auto w-full max-w-7xl px-6 py-8">
    <section class="grid grid-cols-1 gap-6 lg:grid-cols-[1.3fr_0.7fr]">
      <div class="rounded-3xl border border-sky-100 bg-white p-6 shadow-xl shadow-sky-100/70">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Shift Overview</p>
            <h2 class="mt-2 text-3xl font-extrabold text-slate-900">Welcome, {{nurse.name}}</h2>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">
              Monitor online consultations, support doctors and patients, manage queues, and document nursing actions in one secure workspace.
            </p>
          </div>
          <div class="rounded-2xl bg-sky-50 px-4 py-3 text-right">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Assigned Doctor</p>
            <p class="mt-1 text-sm font-bold text-slate-900">{{#if assignedDoctor}}{{assignedDoctor.name}}{{else}}No assigned doctor{{/if}}</p>
            <p class="text-xs text-slate-500">{{#if assignedDoctor}}{{assignedDoctor.specialization}}{{else}}Awaiting assignment{{/if}}</p>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-sky-100 bg-sky-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-700">Consultations Today</p>
            <p class="mt-2 text-3xl font-extrabold text-slate-900">{{stats.todayAppointments}}</p>
          </div>
          <div class="rounded-2xl border border-sky-100 bg-sky-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-700">Patients Monitored</p>
            <p class="mt-2 text-3xl font-extrabold text-slate-900">{{stats.totalPatients}}</p>
          </div>
          <div class="rounded-2xl border border-sky-100 bg-sky-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-700">Records in Review</p>
            <p class="mt-2 text-3xl font-extrabold text-slate-900">{{stats.pendingRecords}}</p>
          </div>
        </div>
      </div>

      <aside class="rounded-3xl border border-sky-100 bg-[linear-gradient(160deg,_#0ea5e9,_#38bdf8)] p-6 text-white shadow-xl shadow-sky-200/60">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-100">Nurse Priorities</p>
        <h2 class="mt-2 text-2xl font-extrabold">Support the full consultation workflow</h2>
        <ul class="mt-5 space-y-3 text-sm text-sky-50/95">
          <li class="flex gap-3"><i class="fa-solid fa-video mt-1"></i><span>Online consultation monitoring and live video assistance</span></li>
          <li class="flex gap-3"><i class="fa-solid fa-clipboard-list mt-1"></i><span>Queue management, appointment confirmation, and schedule control</span></li>
          <li class="flex gap-3"><i class="fa-solid fa-file-medical mt-1"></i><span>Secure EMR access, notes documentation, and medical record review</span></li>
          <li class="flex gap-3"><i class="fa-solid fa-triangle-exclamation mt-1"></i><span>Emergency escalation, alerts, and urgent case support</span></li>
        </ul>
      </aside>
    </section>

    <section class="mt-8 rounded-3xl border border-sky-100 bg-white p-6 shadow-lg shadow-sky-100/60">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Operational Summary</p>
          <h2 class="mt-2 text-2xl font-extrabold text-slate-900">Today's Appointments and Alerts</h2>
        </div>
        <p class="text-sm text-slate-500">Live monitoring for consults, reminders, and patient follow-ups</p>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border border-sky-100 bg-sky-50/70 p-5">
          <h3 class="text-lg font-bold text-slate-900">Today's Appointments</h3>
          <div class="mt-4 space-y-3">
            {{#if todayAppointments.length}}
              {{#each todayAppointments}}
                <div class="rounded-2xl border border-sky-100 bg-white p-4">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <div>
                      <p class="font-semibold text-slate-900">Consultation Schedule</p>
                      <p class="text-sm text-slate-600">{{appointmentDate}} | Status: {{status}}</p>
                    </div>
                    <span class="rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-700">Monitor</span>
                  </div>
                </div>
              {{/each}}
            {{else}}
              <p class="text-sm text-slate-500">No appointments today.</p>
            {{/if}}
          </div>
        </div>

        <div class="rounded-2xl border border-sky-100 bg-sky-50/70 p-5">
          <h3 class="text-lg font-bold text-slate-900">Unread Notifications</h3>
          <div class="mt-4 space-y-3">
            {{#if notifications.length}}
              {{#each notifications}}
                <div class="rounded-2xl border border-sky-100 bg-white p-4">
                  <p class="font-semibold text-slate-900">{{this.title}}</p>
                  <p class="mt-1 text-sm text-slate-600">{{this.message}}</p>
                </div>
              {{/each}}
            {{else}}
              <p class="text-sm text-slate-500">No unread notifications.</p>
            {{/if}}
          </div>
        </div>
      </div>
    </section>

    <section class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="rounded-3xl border border-sky-100 bg-white p-6 shadow-lg shadow-sky-100/60">
        <h2 class="text-xl font-extrabold text-slate-900">Queue Management</h2>
        <form class="mt-4 space-y-4" id="queueForm">
          <div>
            <label class="block text-sm font-semibold text-slate-700">Select Patient</label>
            <select class="mt-2 w-full rounded-xl border border-sky-100 px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-2 focus:ring-sky-200">
              <option>Maria Cruz</option>
              <option>Juan dela Vega</option>
              <option>Ana Santos</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700">Queue Status</label>
            <select class="mt-2 w-full rounded-xl border border-sky-100 px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-2 focus:ring-sky-200">
              <option value="waiting">Waiting</option>
              <option value="ready">Ready for Consultation</option>
              <option value="in-consultation">In Consultation</option>
              <option value="completed">Completed</option>
            </select>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="flex-1 rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white hover:bg-sky-700">Confirm Status</button>
            <button type="button" class="flex-1 rounded-xl border border-sky-200 bg-white px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-50">Notify Doctor</button>
          </div>
        </form>
      </div>

      <div class="rounded-3xl border border-sky-100 bg-white p-6 shadow-lg shadow-sky-100/60">
        <h2 class="text-xl font-extrabold text-slate-900">Vital Signs Recording</h2>
        <form class="mt-4 space-y-4" id="vitalSignsForm">
          <div>
            <label class="block text-sm font-semibold text-slate-700">Temperature (°C)</label>
            <input type="number" step="0.1" placeholder="37.2" class="mt-2 w-full rounded-xl border border-sky-100 px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-2 focus:ring-sky-200">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700">Blood Pressure (mmHg)</label>
            <input type="text" placeholder="120/80" class="mt-2 w-full rounded-xl border border-sky-100 px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-2 focus:ring-sky-200">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700">Heart Rate (bpm)</label>
            <input type="number" placeholder="72" class="mt-2 w-full rounded-xl border border-sky-100 px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-2 focus:ring-sky-200">
          </div>
          <button type="submit" class="w-full rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white hover:bg-sky-700">Record Vital Signs</button>
        </form>
      </div>

      <div class="rounded-3xl border border-sky-100 bg-white p-6 shadow-lg shadow-sky-100/60">
        <h2 class="text-xl font-extrabold text-slate-900">Nursing Notes</h2>
        <form class="mt-4 space-y-4" id="notesForm">
          <div>
            <label class="block text-sm font-semibold text-slate-700">Patient Observation</label>
            <textarea rows="4" placeholder="Document patient condition, symptoms, observations..." class="mt-2 w-full rounded-xl border border-sky-100 px-3 py-2 text-sm text-slate-700 focus:border-sky-500 focus:ring-2 focus:ring-sky-200"></textarea>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="flex-1 rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white hover:bg-sky-700">Save Notes</button>
            <button type="button" class="flex-1 rounded-xl border border-sky-200 bg-white px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-50">Attach File</button>
          </div>
        </form>
      </div>
    </section>

    <section class="mt-8 rounded-3xl border border-sky-100 bg-white p-6 shadow-lg shadow-sky-100/60">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Nurse Functions</p>
          <h2 class="mt-2 text-2xl font-extrabold text-slate-900">Online Consultation and Medical Records System</h2>
        </div>
        <p class="text-sm text-slate-500">Core tools for consultation support, documentation, privacy, and reporting</p>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">1. Online Consultation Monitoring</h3>
          <p class="mt-2 text-sm text-slate-600">Track scheduled online consultations between doctors and patients in real time.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">2. Patient Queue Management</h3>
          <p class="mt-2 text-sm text-slate-600">Organize patient queues, confirm appointments, and manage consultation schedules efficiently.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">3. Video Consultation Assistance</h3>
          <p class="mt-2 text-sm text-slate-600">Support doctors and patients during live sessions and resolve technical concerns quickly.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">4. EMR Access</h3>
          <p class="mt-2 text-sm text-slate-600">Securely view patient histories, diagnoses, prescriptions, laboratory results, and treatment records.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">5. Patient Registration Management</h3>
          <p class="mt-2 text-sm text-slate-600">Register new patients and update profiles within the system.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">6. Vital Signs Recording</h3>
          <p class="mt-2 text-sm text-slate-600">Record and update patient vital signs before and after consultations.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">7. Prescription Monitoring</h3>
          <p class="mt-2 text-sm text-slate-600">Monitor medication orders, dosage schedules, and patient prescription records.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">8. Laboratory Request Coordination</h3>
          <p class="mt-2 text-sm text-slate-600">Process lab requests and upload or monitor laboratory test results.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">9. Consultation Notes Documentation</h3>
          <p class="mt-2 text-sm text-slate-600">Record nursing notes, observations, and consultation summaries for proper documentation.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">10. Appointment Scheduling</h3>
          <p class="mt-2 text-sm text-slate-600">Manage online consultation schedules, follow-ups, and patient appointments.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">11. Real-Time Notifications</h3>
          <p class="mt-2 text-sm text-slate-600">Receive alerts for upcoming consults, medication schedules, and urgent concerns.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">12. Patient Health Tracking</h3>
          <p class="mt-2 text-sm text-slate-600">Monitor progress, treatment response, and recovery updates through the dashboard.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">13. Secure Communication</h3>
          <p class="mt-2 text-sm text-slate-600">Coordinate with nurses, doctors, and patients through secure messaging and follow-up support.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">14. File and Document Upload</h3>
          <p class="mt-2 text-sm text-slate-600">Upload prescriptions, reports, certificates, and patient documents securely.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">15. Emergency Consultation Support</h3>
          <p class="mt-2 text-sm text-slate-600">Escalate urgent online consultations and immediate medical concerns.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">16. Nurse Activity and Shift Monitoring</h3>
          <p class="mt-2 text-sm text-slate-600">Track duties, completed tasks, attendance, and assigned shifts.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <h3 class="font-bold text-slate-900">17. Data Privacy and Security</h3>
          <p class="mt-2 text-sm text-slate-600">Protect patient data with secure login, encrypted records, and role-based access control.</p>
        </article>
        <article class="rounded-2xl border border-sky-100 bg-sky-50 p-5 md:col-span-2 xl:col-span-1">
          <h3 class="font-bold text-slate-900">18. Report Generation</h3>
          <p class="mt-2 text-sm text-slate-600">Generate consultation reports, patient summaries, medical histories, and nursing activity reports.</p>
        </article>
      </div>
    </section>

    <section class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <section class="rounded-3xl border border-sky-100 bg-white p-6 shadow-lg shadow-sky-100/60">
        <h2 class="text-2xl font-extrabold text-slate-900">Recent Records</h2>
        <div class="mt-4 space-y-3">
          {{#if recentRecords.length}}
            {{#each recentRecords}}
              <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm">
                <div>
                  <p class="font-semibold text-slate-900">{{this.title}}</p>
                  <p class="text-slate-600">Created: {{this.createdAt}}</p>
                </div>
                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-sky-700">Review</span>
              </div>
            {{/each}}
          {{else}}
            <p class="text-sm text-slate-500">No recent records available.</p>
          {{/if}}
        </div>
      </section>

      <section class="rounded-3xl border border-sky-100 bg-white p-6 shadow-lg shadow-sky-100/60">
        <h2 class="text-2xl font-extrabold text-slate-900">Health Tracking and Shift Notes</h2>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-sky-100 bg-sky-50 p-4">
            <p class="text-sm font-semibold text-slate-900">Patient Progress</p>
            <p class="mt-1 text-sm text-slate-600">Follow treatment response and recovery updates in one place.</p>
          </div>
          <div class="rounded-2xl border border-sky-100 bg-sky-50 p-4">
            <p class="text-sm font-semibold text-slate-900">Shift Status</p>
            <p class="mt-1 text-sm text-slate-600">Track attendance, assigned duties, and completed tasks for the current shift.</p>
          </div>
          <div class="rounded-2xl border border-sky-100 bg-sky-50 p-4">
            <p class="text-sm font-semibold text-slate-900">Document Uploads</p>
            <p class="mt-1 text-sm text-slate-600">Upload lab results, prescriptions, and certificates securely.</p>
          </div>
          <div class="rounded-2xl border border-sky-100 bg-sky-50 p-4">
            <p class="text-sm font-semibold text-slate-900">Security Controls</p>
            <p class="mt-1 text-sm text-slate-600">Use role-based access and encrypted record handling for patient privacy.</p>
          </div>
        </div>
      </section>
    </section>
  </main>

  <script>
    // Queue Management Form Handler
    document.getElementById('queueForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const patient = e.target.querySelector('select').value;
      const status = e.target.querySelectorAll('select')[1].value;
      alert(`Queue status updated: ${patient} → ${status}`);
      // TODO: Send to backend endpoint /nurse/patient-record/:patientId
    });

    // Vital Signs Form Handler
    document.getElementById('vitalSignsForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputs = e.target.querySelectorAll('input');
      const temp = inputs[0].value;
      const bp = inputs[1].value;
      const hr = inputs[2].value;
      
      if (!temp || !bp || !hr) {
        alert('Please fill in all vital signs fields');
        return;
      }
      
      alert(`Vital signs recorded: Temp ${temp}°C, BP ${bp}, HR ${hr} bpm`);
      // TODO: Send to backend endpoint /nurse/patient-record/:patientId
      e.target.reset();
    });

    // Nursing Notes Form Handler
    document.getElementById('notesForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const notes = e.target.querySelector('textarea').value;
      
      if (!notes.trim()) {
        alert('Please enter nursing notes');
        return;
      }
      
      alert('Nursing notes saved successfully');
      // TODO: Send to backend endpoint /nurse/patient-record/:patientId
      e.target.reset();
    });

    // Attach File Button
    document.querySelectorAll('button').forEach(btn => {
      if (btn.textContent.includes('Attach File')) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const input = document.createElement('input');
          input.type = 'file';
          input.accept = '.pdf,.doc,.docx,.jpg,.png';
          input.addEventListener('change', (ev) => {
            const file = ev.target.files[0];
            if (file) {
              alert(`File attached: ${file.name}`);
              // TODO: Send to backend endpoint for file upload
            }
          });
          input.click();
        });
      }

      // Notify Doctor Button
      if (btn.textContent.includes('Notify Doctor')) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          alert('Doctor notification sent - Patient is ready for consultation');
          // TODO: Send to backend endpoint /notifications
        });
      }
    });
  </script>
</body>
</html>
