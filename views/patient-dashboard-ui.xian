<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Patient Dashboard - Mediserve</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
  <style>
    * {
      font-family: 'Poppins', 'Roboto', sans-serif;
    }
    .rounded-btn {
      border-radius: 8px;
    }
    .card-shadow {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    .dark-mode {
      background: #1a1a1a;
      color: #e0e0e0;
    }
    .dark-mode .bg-white {
      background: #2a2a2a;
    }
    .dark-mode .text-gray-800 {
      color: #e0e0e0;
    }
  </style>
</head>
<body class="bg-gray-50 text-gray-800" id="body">
  <!-- Header -->
  <header class="bg-white border-b border-gray-200 px-6 py-4 sticky top-0 z-50 shadow-sm">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center text-white font-bold">
          <i class="fas fa-heart"></i>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Mediserve</h1>
          <p class="text-xs text-gray-500">Patient Dashboard</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <!-- Dark Mode Toggle -->
        <button id="darkModeToggle" class="text-gray-600 hover:text-gray-900 text-lg p-2 rounded-lg hover:bg-gray-100">
          <i class="fas fa-moon"></i>
        </button>
        
        <!-- Notification Bell -->
        <div class="relative group">
          <button class="text-gray-600 hover:text-gray-900 relative">
            <i class="fas fa-bell text-xl"></i>
            <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">{{notifications.length}}</span>
          </button>
          <div class="hidden group-hover:block absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-lg p-4 z-50 card-shadow">
            <div class="space-y-3 max-h-96 overflow-y-auto">
              <p class="text-sm font-semibold text-gray-700">Recent Notifications</p>
              {{#if notifications.length}}
                {{#each notifications}}
                  <div class="border-l-4 border-blue-500 pl-3 py-2 hover:bg-gray-50 p-2 rounded">
                    <p class="text-sm font-medium">{{this.title}}</p>
                    <p class="text-xs text-gray-500">{{this.message}}</p>
                    <p class="text-xs text-gray-400">{{this.createdAt}}</p>
                  </div>
                {{/each}}
              {{else}}
                <p class="text-sm text-gray-500">No notifications yet</p>
              {{/if}}
            </div>
          </div>
        </div>
        
        <!-- Profile Avatar Dropdown -->
        <div class="relative group">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white text-sm font-semibold cursor-pointer">
            {{patientInitials}}
          </div>
          <div class="hidden group-hover:block absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg p-3 z-50 card-shadow">
            <a href="#profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded">Edit Profile</a>
            <a href="/logout" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded">Logout</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Layout -->
  <div class="flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 min-h-screen sticky top-16">
      <nav class="p-6 space-y-2">
        <!-- Dashboard -->
        <a href="#dashboard" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-btn transition">
          <i class="fas fa-home text-lg"></i>
          <span class="font-medium">Dashboard</span>
        </a>
        
        <!-- Book Appointment -->
        <a href="#book-appointment" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-btn transition">
          <i class="fas fa-calendar-plus text-lg"></i>
          <span class="font-medium">Book Appointment</span>
        </a>
        
        <!-- My Appointments -->
        <a href="#my-appointments" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-btn transition">
          <i class="fas fa-calendar-check text-lg"></i>
          <span class="font-medium">My Appointments</span>
          {{#if upcomingCount}}
            <span class="ml-auto bg-blue-500 text-white text-xs px-2 py-1 rounded-full">{{upcomingCount}}</span>
          {{/if}}
        </a>
        
        <!-- Consultations -->
        <a href="#consultations" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-btn transition">
          <i class="fas fa-video text-lg"></i>
          <span class="font-medium">Consultations</span>
          {{#if activeConsultations}}
            <span class="ml-auto bg-green-500 text-white text-xs px-2 py-1 rounded-full">{{activeConsultations}}</span>
          {{/if}}
        </a>
        
        <!-- Prescriptions -->
        <a href="#prescriptions" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-btn transition">
          <i class="fas fa-prescription-bottle text-lg"></i>
          <span class="font-medium">Prescriptions</span>
        </a>
        
        <!-- Medical Records -->
        <a href="#medical-records" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-btn transition">
          <i class="fas fa-file-medical text-lg"></i>
          <span class="font-medium">Medical Records</span>
        </a>
        
        <!-- Payments -->
        <a href="#payments" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-btn transition">
          <i class="fas fa-credit-card text-lg"></i>
          <span class="font-medium">Payments</span>
        </a>
        
        <!-- Messages -->
        <a href="#messages" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-btn transition">
          <i class="fas fa-envelope text-lg"></i>
          <span class="font-medium">Messages</span>
          {{#if unreadMessages}}
            <span class="ml-auto bg-red-500 text-white text-xs px-2 py-1 rounded-full">{{unreadMessages}}</span>
          {{/if}}
        </a>

        <hr class="my-4 border-gray-200">
        
        <!-- Logout -->
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 rounded-btn transition">
          <i class="fas fa-sign-out-alt text-lg"></i>
          <span class="font-medium">Logout</span>
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8 max-w-7xl">
      <!-- Dashboard Overview -->
      <section id="dashboard" class="mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Welcome, {{patientName}}!</h2>
        
        <!-- Overview Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <!-- Upcoming Appointment Card -->
          <div class="bg-white rounded-btn p-6 card-shadow hover:shadow-lg transition">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-700">Upcoming Appointment</h3>
              <i class="fas fa-calendar-days text-2xl text-blue-500"></i>
            </div>
            {{#if nextAppointment}}
              <p class="text-2xl font-bold text-gray-900 mb-2">Dr. {{nextAppointment.doctorName}}</p>
              <p class="text-sm text-gray-600">{{nextAppointment.appointmentDate}} at {{nextAppointment.time}}</p>
              <p class="text-xs text-blue-600 mt-2">{{nextAppointment.type}}</p>
            {{else}}
              <p class="text-gray-500 text-sm">No upcoming appointments</p>
            {{/if}}
          </div>

          <!-- Latest Prescription Card -->
          <div class="bg-white rounded-btn p-6 card-shadow hover:shadow-lg transition">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-700">Latest Prescription</h3>
              <i class="fas fa-prescription-bottle text-2xl text-green-500"></i>
            </div>
            {{#if latestPrescription}}
              <p class="text-sm font-medium text-gray-900">{{latestPrescription.medicineName}}</p>
              <p class="text-xs text-gray-600 mt-1">Dosage: {{latestPrescription.dosage}}</p>
              <p class="text-xs text-gray-600">From: Dr. {{latestPrescription.doctorName}}</p>
            {{else}}
              <p class="text-gray-500 text-sm">No prescriptions yet</p>
            {{/if}}
          </div>

          <!-- Messages Card -->
          <div class="bg-white rounded-btn p-6 card-shadow hover:shadow-lg transition">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-700">Messages</h3>
              <i class="fas fa-envelope text-2xl text-yellow-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900 mb-2">{{unreadMessages}}</p>
            <p class="text-sm text-gray-600">Unread messages</p>
            <a href="#messages" class="text-blue-600 text-xs hover:underline mt-2 inline-block">View All →</a>
          </div>

          <!-- Notifications Card -->
          <div class="bg-white rounded-btn p-6 card-shadow hover:shadow-lg transition">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-700">Notifications</h3>
              <i class="fas fa-bell text-2xl text-red-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900 mb-2">{{notifications.length}}</p>
            <p class="text-sm text-gray-600">New alerts</p>
            <a href="#notifications" class="text-blue-600 text-xs hover:underline mt-2 inline-block">Review →</a>
          </div>
        </div>

        <!-- Analytics Charts -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
          <!-- Health Analytics -->
          <div class="bg-white rounded-btn p-6 card-shadow">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Health Metrics</h3>
            <canvas id="healthChart"></canvas>
            <p class="text-xs text-gray-500 mt-3">Last 6 months overview</p>
          </div>

          <!-- Appointment History -->
          <div class="bg-white rounded-btn p-6 card-shadow">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Appointment Trends</h3>
            <canvas id="appointmentChart"></canvas>
            <p class="text-xs text-gray-500 mt-3">This year's appointments</p>
          </div>
        </div>
      </section>

      <!-- Book Appointment Section -->
      <section id="book-appointment" class="mb-12 bg-white rounded-btn p-8 card-shadow">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Book an Appointment</h3>
        <form class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Select Doctor -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Select Doctor *</label>
            <select id="doctorSelect" class="w-full border border-gray-300 rounded-btn px-4 py-2 focus:outline-none focus:border-blue-500 transition" required>
              <option value="">-- Choose a doctor --</option>
              {{#each doctors}}
                <option value="{{this.id}}">Dr. {{this.name}} - {{this.specialization}}</option>
              {{/each}}
            </select>
          </div>

          <!-- Specialization (Auto-filled) -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Specialization</label>
            <input type="text" id="specialization" class="w-full border border-gray-300 rounded-btn px-4 py-2 bg-gray-50 text-gray-600" readonly>
          </div>

          <!-- Date Picker -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Select Date *</label>
            <input type="date" id="appointmentDate" class="w-full border border-gray-300 rounded-btn px-4 py-2 focus:outline-none focus:border-blue-500 transition" required>
          </div>

          <!-- Time Slot -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Select Time *</label>
            <select id="timeSlot" class="w-full border border-gray-300 rounded-btn px-4 py-2 focus:outline-none focus:border-blue-500 transition" required>
              <option value="">-- Choose time --</option>
              <option value="09:00">09:00 AM</option>
              <option value="10:00">10:00 AM</option>
              <option value="11:00">11:00 AM</option>
              <option value="14:00">02:00 PM</option>
              <option value="15:00">03:00 PM</option>
              <option value="16:00">04:00 PM</option>
            </select>
          </div>

          <!-- Consultation Type -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Consultation Type *</label>
            <div class="flex gap-4">
              <label class="flex items-center">
                <input type="radio" name="consultationType" value="Video" checked class="mr-2">
                <span class="text-sm">Video Call</span>
              </label>
              <label class="flex items-center">
                <input type="radio" name="consultationType" value="Chat" class="mr-2">
                <span class="text-sm">Chat</span>
              </label>
            </div>
          </div>

          <!-- Reason for Consultation -->
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-2">Reason for Consultation</label>
            <textarea id="consultationReason" placeholder="Brief description of your concern..." class="w-full border border-gray-300 rounded-btn px-4 py-2 focus:outline-none focus:border-blue-500 transition resize-none" rows="4"></textarea>
          </div>

          <!-- Book Now Button -->
          <div class="md:col-span-2">
            <button type="submit" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold px-6 py-3 rounded-btn transition">
              <i class="fas fa-check mr-2"></i> Book Now
            </button>
          </div>
        </form>
      </section>

      <!-- My Appointments Section -->
      <section id="my-appointments" class="mb-12 bg-white rounded-btn p-8 card-shadow">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">My Appointments</h3>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Doctor</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Specialization</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Date & Time</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Type</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Status</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {{#if appointments.length}}
                {{#each appointments}}
                  <tr class="hover:bg-gray-50 transition">
                    <td class="px-4 py-3 text-sm text-gray-900">Dr. {{this.doctorName}}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">{{this.specialization}}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">{{this.appointmentDate}} at {{this.time}}</td>
                    <td class="px-4 py-3 text-sm">
                      <span class="px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800">
                        {{this.type}}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-sm">
                      <span class="px-2 py-1 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                        {{this.status}}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-sm">
                      {{#if this.status}}
                        {{#if this.status}}
                          <button class="text-blue-600 hover:text-blue-800 font-medium text-xs mr-3" onclick="joinConsultation('{{this.id}}')">
                            <i class="fas fa-video mr-1"></i> Join
                          </button>
                          <button class="text-red-600 hover:text-red-800 font-medium text-xs" onclick="cancelAppointment('{{this.id}}')">
                            <i class="fas fa-times mr-1"></i> Cancel
                          </button>
                        {{/if}}
                      {{/if}}
                    </td>
                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="6" class="px-4 py-6 text-center text-gray-500">No appointments scheduled</td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Consultations Section -->
      <section id="consultations" class="mb-12 bg-white rounded-btn p-8 card-shadow">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Active Consultations</h3>
        
        {{#if activeConsultation}}
          <!-- Consultation Panel -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Video Area -->
            <div class="lg:col-span-2">
              <div class="bg-black rounded-btn overflow-hidden aspect-video flex items-center justify-center relative">
                <div id="videoPlaceholder" class="text-center text-white">
                  <i class="fas fa-video text-6xl mb-4"></i>
                  <p class="text-lg">Video Stream Loading...</p>
                </div>
              </div>
              
              <!-- Controls -->
              <div class="mt-4 flex gap-3 justify-center">
                <button class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-btn flex items-center gap-2 transition">
                  <i class="fas fa-microphone"></i> Mute
                </button>
                <button class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-btn flex items-center gap-2 transition">
                  <i class="fas fa-share-screen"></i> Share Screen
                </button>
                <button onclick="endConsultation()" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-btn flex items-center gap-2 transition">
                  <i class="fas fa-phone-slash"></i> End Call
                </button>
              </div>
            </div>

            <!-- Right Panel -->
            <div class="space-y-6">
              <!-- Doctor Info -->
              <div class="bg-gray-50 rounded-btn p-4">
                <h4 class="font-semibold text-gray-900 mb-3">Doctor Info</h4>
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-12 h-12 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold">
                    {{activeConsultation.doctorInitial}}
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Dr. {{activeConsultation.doctorName}}</p>
                    <p class="text-xs text-gray-600">{{activeConsultation.specialization}}</p>
                  </div>
                </div>
                <p class="text-sm text-gray-600">Experience: {{activeConsultation.experience}} years</p>
              </div>

              <!-- Chat Box -->
              <div class="bg-gray-50 rounded-btn p-4 flex flex-col h-80">
                <h4 class="font-semibold text-gray-900 mb-3">Chat</h4>
                <div id="chatMessages" class="flex-1 space-y-3 overflow-y-auto mb-3 text-sm">
                  <div class="bg-blue-100 text-blue-900 p-2 rounded text-xs max-w-xs">
                    <p class="font-medium">Dr. {{activeConsultation.doctorName}}</p>
                    <p>Hello! How can I help you today?</p>
                  </div>
                </div>
                <div class="flex gap-2">
                  <input type="text" id="chatInput" placeholder="Type message..." class="flex-1 border border-gray-300 rounded-btn px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
                  <button class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-2 rounded-btn text-sm transition">
                    <i class="fas fa-paper-plane"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        {{else}}
          <p class="text-gray-500 text-center py-8">No active consultations at the moment</p>
        {{/if}}
      </section>

      <!-- Prescriptions Section -->
      <section id="prescriptions" class="mb-12 bg-white rounded-btn p-8 card-shadow">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">My Prescriptions</h3>
        <div class="space-y-4">
          {{#if prescriptions.length}}
            {{#each prescriptions}}
              <div class="border border-gray-200 rounded-btn p-4 hover:shadow-md transition">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-start mb-4">
                  <div>
                    <p class="text-xs text-gray-600 font-semibold">MEDICINE</p>
                    <p class="text-sm font-medium text-gray-900">{{this.medicineName}}</p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-600 font-semibold">DOSAGE</p>
                    <p class="text-sm font-medium text-gray-900">{{this.dosage}}</p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-600 font-semibold">FREQUENCY</p>
                    <p class="text-sm font-medium text-gray-900">{{this.frequency}}</p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-600 font-semibold">DURATION</p>
                    <p class="text-sm font-medium text-gray-900">{{this.duration}}</p>
                  </div>
                </div>
                
                <div class="mb-4">
                  <p class="text-xs text-gray-600 font-semibold mb-1">INSTRUCTIONS</p>
                  <p class="text-sm text-gray-700">{{this.instructions}}</p>
                </div>

                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-xs text-gray-600">From Dr. {{this.doctorName}}</p>
                    <p class="text-xs text-gray-500">{{this.createdAt}}</p>
                  </div>
                  <button class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-btn text-sm flex items-center gap-2 transition">
                    <i class="fas fa-download"></i> Download PDF
                  </button>
                </div>
              </div>
            {{/each}}
          {{else}}
            <p class="text-gray-500 text-center py-8">No prescriptions yet</p>
          {{/if}}
        </div>
      </section>

      <!-- Medical Records Section -->
      <section id="medical-records" class="mb-12 bg-white rounded-btn p-8 card-shadow">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Medical Records</h3>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
          <!-- Upload Section -->
          <div class="lg:col-span-2 border-2 border-dashed border-gray-300 rounded-btn p-8 text-center hover:border-blue-500 transition cursor-pointer" onclick="document.getElementById('fileInput').click()">
            <i class="fas fa-cloud-upload-alt text-3xl text-gray-400 mb-3"></i>
            <p class="font-medium text-gray-900 mb-1">Upload Medical Document</p>
            <p class="text-sm text-gray-600 mb-3">Drag and drop or click to select</p>
            <input type="file" id="fileInput" class="hidden" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
          </div>

          <!-- Records Summary -->
          <div class="bg-gray-50 rounded-btn p-6">
            <h4 class="font-semibold text-gray-900 mb-3">Records Summary</h4>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-gray-600">Total Records:</span>
                <span class="font-semibold">{{totalRecords}}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Lab Reports:</span>
                <span class="font-semibold">{{labReports}}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">X-Rays:</span>
                <span class="font-semibold">{{xrayReports}}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Others:</span>
                <span class="font-semibold">{{otherRecords}}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Records List -->
        <h4 class="font-semibold text-gray-900 mb-4">Your Records</h4>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Record Type</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">File Name</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Date</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Doctor</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {{#if medicalRecords.length}}
                {{#each medicalRecords}}
                  <tr class="hover:bg-gray-50 transition">
                    <td class="px-4 py-3 text-sm text-gray-900">{{this.type}}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">{{this.fileName}}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">{{this.date}}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">Dr. {{this.doctorName}}</td>
                    <td class="px-4 py-3 text-sm">
                      <button class="text-blue-600 hover:text-blue-800 font-medium text-xs mr-3">
                        <i class="fas fa-download mr-1"></i> Download
                      </button>
                      <button class="text-gray-600 hover:text-gray-800 font-medium text-xs">
                        <i class="fas fa-eye mr-1"></i> View
                      </button>
                    </td>
                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="5" class="px-4 py-6 text-center text-gray-500">No medical records available</td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Payments Section -->
      <section id="payments" class="mb-12 bg-white rounded-btn p-8 card-shadow">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Payments</h3>
        
        <!-- Payment Form -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
          <div class="bg-gray-50 rounded-btn p-6">
            <h4 class="font-semibold text-gray-900 mb-4">Make a Payment</h4>
            <form class="space-y-4">
              <!-- Consultation Fee -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Amount (₱) *</label>
                <input type="number" placeholder="Enter consultation fee" class="w-full border border-gray-300 rounded-btn px-4 py-2 focus:outline-none focus:border-blue-500" required>
              </div>

              <!-- Payment Method -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Payment Method *</label>
                <select class="w-full border border-gray-300 rounded-btn px-4 py-2 focus:outline-none focus:border-blue-500" required>
                  <option value="">-- Select method --</option>
                  <option value="gcash">GCash</option>
                  <option value="card">Credit/Debit Card</option>
                  <option value="online_banking">Online Banking</option>
                  <option value="bank_transfer">Bank Transfer</option>
                </select>
              </div>

              <!-- Reference Number -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Reference Number / Appointment ID</label>
                <input type="text" placeholder="Optional" class="w-full border border-gray-300 rounded-btn px-4 py-2 focus:outline-none focus:border-blue-500">
              </div>

              <!-- Pay Now Button -->
              <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white font-semibold px-6 py-3 rounded-btn transition flex items-center justify-center gap-2">
                <i class="fas fa-check"></i> Pay Now
              </button>
            </form>
          </div>

          <!-- Payment Summary -->
          <div class="space-y-4">
            <div class="bg-blue-50 border border-blue-200 rounded-btn p-6">
              <h4 class="font-semibold text-gray-900 mb-3">Account Balance</h4>
              <p class="text-3xl font-bold text-blue-600 mb-2">₱{{accountBalance}}</p>
              <p class="text-sm text-gray-600">Available credits</p>
            </div>

            <div class="bg-green-50 border border-green-200 rounded-btn p-6">
              <h4 class="font-semibold text-gray-900 mb-3">Due Amount</h4>
              <p class="text-3xl font-bold text-green-600 mb-2">₱{{dueAmount}}</p>
              <p class="text-sm text-gray-600">Pending payments</p>
            </div>
          </div>
        </div>

        <!-- Payment History -->
        <h4 class="font-semibold text-gray-900 mb-4">Payment History</h4>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Date</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Description</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Amount</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Method</th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {{#if paymentHistory.length}}
                {{#each paymentHistory}}
                  <tr class="hover:bg-gray-50 transition">
                    <td class="px-4 py-3 text-sm text-gray-600">{{this.date}}</td>
                    <td class="px-4 py-3 text-sm text-gray-900">{{this.description}}</td>
                    <td class="px-4 py-3 text-sm font-medium text-gray-900">₱{{this.amount}}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">{{this.method}}</td>
                    <td class="px-4 py-3 text-sm">
                      <span class="px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">
                        {{this.status}}
                      </span>
                    </td>
                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="5" class="px-4 py-6 text-center text-gray-500">No payment history</td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Messages Section -->
      <section id="messages" class="mb-12 bg-white rounded-btn p-8 card-shadow">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Messages</h3>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Conversations List -->
          <div class="border border-gray-200 rounded-btn overflow-hidden">
            <div class="bg-gray-50 px-4 py-3 border-b border-gray-200 flex items-center justify-between">
              <h4 class="font-semibold text-gray-900">Conversations</h4>
              <input type="text" placeholder="Search..." class="w-32 border border-gray-300 rounded px-2 py-1 text-xs">
            </div>
            <div class="divide-y divide-gray-200 max-h-96 overflow-y-auto">
              {{#if conversations.length}}
                {{#each conversations}}
                  <div class="px-4 py-3 hover:bg-blue-50 cursor-pointer transition border-l-4 {{#if this.unread}}border-blue-500 bg-blue-50{{else}}border-transparent{{/if}}" onclick="selectConversation('{{this.id}}')">
                    <p class="font-medium text-sm text-gray-900">Dr. {{this.doctorName}}</p>
                    <p class="text-xs text-gray-600 truncate">{{this.lastMessage}}</p>
                    <p class="text-xs text-gray-500 mt-1">{{this.time}}</p>
                  </div>
                {{/each}}
              {{else}}
                <div class="px-4 py-6 text-center text-gray-500 text-sm">No conversations</div>
              {{/if}}
            </div>
          </div>

          <!-- Chat Window -->
          <div class="lg:col-span-2 border border-gray-200 rounded-btn flex flex-col">
            {{#if selectedConversation}}
              <!-- Chat Header -->
              <div class="bg-gradient-to-r from-blue-500 to-blue-600 text-white px-6 py-4 border-b border-blue-600 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-blue-400 flex items-center justify-center text-sm font-bold">
                    {{selectedConversation.doctorInitial}}
                  </div>
                  <div>
                    <p class="font-medium">Dr. {{selectedConversation.doctorName}}</p>
                    <p class="text-xs text-blue-100">Online</p>
                  </div>
                </div>
                <button class="text-white hover:text-blue-100">
                  <i class="fas fa-info-circle text-xl"></i>
                </button>
              </div>

              <!-- Messages Area -->
              <div id="messagesArea" class="flex-1 overflow-y-auto p-4 space-y-4 bg-white">
                {{#each selectedConversation.messages}}
                  <div class="flex justify-start">
                    <div class="max-w-xs bg-gray-200 text-gray-900 px-4 py-2 rounded-btn">
                      <p class="text-sm">{{this.text}}</p>
                      <p class="text-xs text-gray-600 mt-1">{{this.time}}</p>
                    </div>
                  </div>
                {{/each}}
              </div>

              <!-- Message Input -->
              <div class="border-t border-gray-200 px-4 py-4">
                <div class="flex gap-3">
                  <input type="text" id="messageInput" placeholder="Type your message..." class="flex-1 border border-gray-300 rounded-btn px-4 py-2 focus:outline-none focus:border-blue-500 text-sm">
                  <button class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-btn transition">
                    <i class="fas fa-paper-plane"></i>
                  </button>
                </div>
              </div>
            {{else}}
              <div class="flex-1 flex items-center justify-center text-gray-500">
                <div class="text-center">
                  <i class="fas fa-comments text-4xl mb-3"></i>
                  <p>Select a conversation to start messaging</p>
                </div>
              </div>
            {{/if}}
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- Scripts -->
  <script>
    // Dark Mode Toggle
    const darkModeToggle = document.getElementById('darkModeToggle');
    const body = document.getElementById('body');
    
    darkModeToggle.addEventListener('click', () => {
      body.classList.toggle('dark-mode');
      localStorage.setItem('darkMode', body.classList.contains('dark-mode'));
    });

    // Initialize Dark Mode from localStorage
    if (localStorage.getItem('darkMode') === 'true') {
      body.classList.add('dark-mode');
    }

    // Doctor Select Handler
    document.getElementById('doctorSelect').addEventListener('change', function() {
      const doctorId = this.value;
      const doctors = {
        {{#each doctors}}
          '{{this.id}}': { specialization: '{{this.specialization}}' },
        {{/each}}
      };
      
      if (doctors[doctorId]) {
        document.getElementById('specialization').value = doctors[doctorId].specialization;
      }
    });

    // Set minimum date to today
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('appointmentDate').min = today;

    // Consultation Functions
    function joinConsultation(appointmentId) {
      document.getElementById('consultations').scrollIntoView({ behavior: 'smooth' });
      console.log('Joining consultation:', appointmentId);
    }

    function cancelAppointment(appointmentId) {
      if (confirm('Are you sure you want to cancel this appointment?')) {
        console.log('Cancelled appointment:', appointmentId);
        // Send cancel request to backend
      }
    }

    function endConsultation() {
      if (confirm('End consultation?')) {
        console.log('Consultation ended');
        // Send end consultation to backend
      }
    }

    function selectConversation(conversationId) {
      console.log('Selected conversation:', conversationId);
      // Load conversation messages
    }

    // Initialize Charts
    const healthCtx = document.getElementById('healthChart')?.getContext('2d');
    if (healthCtx) {
      new Chart(healthCtx, {
        type: 'line',
        data: {
          labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
          datasets: [{
            label: 'Health Score',
            data: [65, 75, 70, 80, 78, 85],
            borderColor: '#2A7FFF',
            backgroundColor: 'rgba(42, 127, 255, 0.1)',
            tension: 0.4,
            fill: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: { display: false }
          }
        }
      });
    }

    const appointmentCtx = document.getElementById('appointmentChart')?.getContext('2d');
    if (appointmentCtx) {
      new Chart(appointmentCtx, {
        type: 'bar',
        data: {
          labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
          datasets: [{
            label: 'Appointments',
            data: [5, 8, 6, 9, 7, 10],
            backgroundColor: '#2A7FFF'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: { display: false }
          }
        }
      });
    }
  </script>
</body>
</html>
